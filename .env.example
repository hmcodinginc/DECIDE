# Documentation only. Vite does not load a .env at the repository root.
# Copy client/.env.example to client/.env.local for local development.
# Never put service-role or webhook secrets in VITE_ variables.
#
# Vercel: set these same VITE_ names on the project (root directory = client).

VITE_SITE_URL=http://localhost:5173
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_RAZORPAY_KEY_ID=
