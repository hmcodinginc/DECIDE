# Vite loads this directory (`client/`), not the repository root.
# Copy this file to .env.local and fill in values. Never commit .env.local.
# Never put service-role or webhook secrets in VITE_ variables.

VITE_SITE_URL=http://localhost:5173
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional alias if the dashboard shows a publishable key instead of anon.
# VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_RAZORPAY_KEY_ID=
